{
  "name": "svg-scroll-draw",
  "version": "0.5.0",
  "description": "Scroll-driven SVG path drawing animation library — zero dependencies, under 3KB gzipped, works with React, Vue, and vanilla JS",
  "keywords": [
    "svg",
    "scroll",
    "animation",
    "path",
    "draw",
    "stroke-dashoffset",
    "scroll-driven",
    "intersection-observer",
    "react",
    "vue",
    "nextjs",
    "web-animation",
    "svg-animation",
    "scroll-animation",
    "path-drawing",
    "vanilla-js",
    "web-component",
    "zero-dependencies",
    "lightweight",
    "svelte",
    "svelte-action",
    "solid",
    "solidjs",
    "angular",
    "horizontal-scroll",
    "color-animation",
    "waypoints"
  ],
  "homepage": "https://ink-scroll.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/DhruvilChauahan0210/ink-scroll.git",
    "directory": "packages/svg-scroll-draw"
  },
  "bugs": {
    "url": "https://github.com/DhruvilChauahan0210/ink-scroll/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/DhruvilChauahan0210"
  },
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.mjs",
      "require": "./dist/svelte/index.cjs"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.mjs",
      "require": "./dist/solid/index.cjs"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.mjs",
      "require": "./dist/angular/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^25.0.0",
    "solid-js": "^1.9.13",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.34"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3",
    "solid-js": ">=1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
