{
  "name": "svg-scroll-draw",
  "version": "2.10.0",
  "description": "Scroll-driven animation for the web \u2014 draw SVG paths, reveal elements, pin sections, scrub video. Zero dependencies, native CSS fast path, works with React, Vue, Svelte, Solid, Angular, Astro and vanilla JS",
  "keywords": [
    "svg",
    "scroll",
    "animation",
    "path",
    "draw",
    "stroke-dashoffset",
    "scroll-driven",
    "intersection-observer",
    "react",
    "vue",
    "nextjs",
    "web-animation",
    "svg-animation",
    "scroll-animation",
    "path-drawing",
    "vanilla-js",
    "web-component",
    "zero-dependencies",
    "lightweight",
    "svelte",
    "svelte-action",
    "solid",
    "solidjs",
    "angular",
    "horizontal-scroll",
    "color-animation",
    "waypoints",
    "astro",
    "nuxt",
    "path-morphing",
    "svg-morph",
    "sequence",
    "group",
    "bounce-easing",
    "elastic-easing",
    "spring-easing",
    "physics-easing"
  ],
  "homepage": "https://svg-scroll-draw.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DhruvilChauahan0210/ink-scroll.git",
    "directory": "packages/svg-scroll-draw"
  },
  "bugs": {
    "url": "https://github.com/DhruvilChauahan0210/ink-scroll/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/DhruvilChauahan0210"
  },
  "license": "MIT",
  "bin": {
    "svg-scroll-draw": "./dist/cli/init.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
